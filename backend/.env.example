# Modelo das variáveis de ambiente do backend.
# Copie este arquivo para ".env" e ajuste os valores:  cp .env.example .env
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).

# development (padrão) ou production. Em production o JWT_SECRET fraco impede a API de subir
# e o Swagger fica desligado.
NODE_ENV=development

# Porta onde a API sobe (o front espera http://localhost:3000/api)
PORT=3000

# Segredo usado para assinar os tokens JWT.
# TROQUE por um valor longo e aleatório (mínimo de 32 caracteres). Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# Validade do token de acesso (8h acompanha a sessão do front)
JWT_EXPIRES_IN=8h

# Origens do front-end liberadas no CORS, separadas por vírgula. Nunca use "*".
# Para testar o build com SSR do front, acrescente a porta 4000:
# CORS_ORIGINS=http://localhost:4200,http://localhost:4000
CORS_ORIGINS=http://localhost:4200

# Fuso da escola. Define o que é "hoje" para prazos e atrasos (Amapá = America/Belem, UTC-3).
APP_TIMEZONE=America/Belem

# Banco de dados PostgreSQL. O valor abaixo é o do docker-compose.yml da raiz do projeto.
# Usado por "npm run db:migrate" e "npm run db:seed".
DATABASE_URL=postgresql://fab:fab_dev@localhost:5432/fab

# Em produção o Swagger (/api/docs) fica desligado. Para ligar mesmo assim: SWAGGER_ATIVO=true
