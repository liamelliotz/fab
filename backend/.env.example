# Modelo das variáveis de ambiente do backend.
# Copie este arquivo para ".env" e ajuste os valores:  cp .env.example .env
# NUNCA faça commit do arquivo .env (ele já está no .gitignore).

# Porta onde a API sobe (o front espera http://localhost:3000/api)
PORT=3000

# Segredo usado para assinar os tokens JWT.
# TROQUE por um valor longo e aleatório. Não use este texto de exemplo.
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# Validade do token de acesso (8h acompanha a sessão do front)
JWT_EXPIRES_IN=8h
